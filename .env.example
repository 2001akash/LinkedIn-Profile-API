# Copy to .env and fill in with your LinkedIn account credentials
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=
PORT=3000
# Optional: set HEADLESS=false to see the browser for debugging
HEADLESS=true
# Use API-mode (no browser) - requires a valid LinkedIn session cookie
# Set USE_API=true to use the API-based scraper
USE_API=false
# LinkedIn session cookie values (do NOT commit real secrets to git)
LI_AT=
JSESSIONID=
